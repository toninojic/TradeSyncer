# Copy settings for TradeCopier.
#
# Easiest: do NOT edit this file by hand. Run (in the backend folder)
#     python -m app.cli init
# which creates a ready-to-use .env next to this file.
#
# If you do it by hand: copy this file to .env and fill in the three secrets.

# --- admin login -------------------------------------------------------------
ADMIN_USERNAME=admin
# Hash of the admin password (never the password itself). Create with:
#     python -m app.cli hash-password
ADMIN_PASSWORD_HASH=
# Random string that signs the login cookie, e.g. from:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- encryption of broker credentials ---------------------------------------
# Create with:  python -m app.cli gen-key
# Keep it safe: without it saved broker credentials cannot be decrypted.
ENCRYPTION_KEY=

# --- server -------------------------------------------------------------------
# 127.0.0.1 = reachable only from this computer (recommended).
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# --- copier / simulator -------------------------------------------------------
# Create 1 leader + 3 followers on first start (only when the database is empty).
SEED_DEMO_DATA=true
# Let simulated prices move by themselves.
SIM_RANDOM_WALK=true
# How often the reconciliation loop checks every follower (seconds).
RECONCILE_INTERVAL_S=3.0
